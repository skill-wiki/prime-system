unit CredentialStuffing : Threat {
  id: "@sec/threat-credential-stuffing"
  version: "1.0.0"

  name: "Credential Stuffing"
  vector: "authentication endpoint"
  severity: 4
  narrative: "Reused passwords from unrelated breaches are replayed against the login endpoint."

  endangers: [
    @sec/asset-customer-database,
  ]

  mitigated-by: [
    @sec/control-multi-factor,
  ]
}
