{
  "name": "@aoe/mcp-server-core",
  "version": "0.2.0",
  "description": "AOE MCP transport for a verified Model Package and compiled Corpus snapshot.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "aoe-mcp": "dist/index.js"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@aoe/ir": "workspace:*",
    "@aoe/model-schema": "workspace:*",
    "@aoe/projection-engine": "workspace:*",
    "@aoe/query-engine": "workspace:*",
    "@aoe/runtime": "workspace:*",
    "zod": "^4.0.0"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --external '@modelcontextprotocol/*' --external zod && node -e \"const f='dist/index.js';const fs=require('fs');let s=fs.readFileSync(f,'utf8');if(s.startsWith('#!'))s=s.replace(/^#![^\\n]*\\n/,'#!/usr/bin/env node\\n');else s='#!/usr/bin/env node\\n'+s;fs.writeFileSync(f,s);fs.chmodSync(f,0o755);\"",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "aoe",
    "knowledge-runtime",
    "mcp",
    "model-context-protocol",
    "stdio"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kernary-aoe/aoe-engine.git",
    "directory": "packages/mcp-server-core"
  },
  "homepage": "https://github.com/kernary-aoe/aoe-engine/tree/main/packages/mcp-server-core#readme",
  "bugs": {
    "url": "https://github.com/kernary-aoe/aoe-engine/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
