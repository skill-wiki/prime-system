{
  "name": "@skill-wiki/http-server",
  "version": "0.2.0",
  "description": "Authenticated HTTP transport over the kernel's snapshot/plan/query/resource surface. Loopback by default, bearer-credentialed, OTLP-traced.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "kernary-http-server": "src/main.ts",
    "prime-http-server": "src/main.ts"
  },
  "scripts": {
    "serve": "bun src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@skill-wiki/ir": "workspace:*",
    "@skill-wiki/observability": "workspace:*",
    "@skill-wiki/query-engine": "workspace:*",
    "@skill-wiki/runtime": "workspace:*",
    "@skill-wiki/sdk": "workspace:*"
  },
  "devDependencies": {
    "@skill-wiki/model-schema": "workspace:*"
  }
}
