{
  "name": "@aoe/cli",
  "version": "0.2.0",
  "description": "AOE CLI — author, compile, inspect, query, and operate Agent Ontology Packages.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "aoe": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun && node -e \"const f='dist/index.js';const fs=require('fs');let s=fs.readFileSync(f,'utf8');if(s.startsWith('#!'))s=s.replace(/^#![^\\n]*\\n/,'#!/usr/bin/env bun\\n');else s='#!/usr/bin/env bun\\n'+s;fs.writeFileSync(f,s);fs.chmodSync(f,0o755);\" && bun dist/index.js --version",
    "prepublishOnly": "bun run build",
    "test": "bun test --pass-with-no-tests",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aoe/action-runtime": "workspace:*",
    "@aoe/bundle": "workspace:*",
    "@aoe/compiler": "workspace:*",
    "@aoe/event-store": "workspace:*",
    "@aoe/ir": "workspace:*",
    "@aoe/language-server": "workspace:*",
    "@aoe/model-schema": "workspace:*",
    "@aoe/parser": "workspace:*",
    "@aoe/runtime": "workspace:*",
    "@aoe/types": "workspace:*"
  },
  "keywords": [
    "aoe",
    "knowledge-runtime",
    "mcp",
    "ai-agents",
    "cli"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kernary-aoe/aoe-engine.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/kernary-aoe/aoe-engine/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/kernary-aoe/aoe-engine/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "Apache-2.0"
}
